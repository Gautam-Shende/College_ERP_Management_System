# Security: Ignore environment files and secret keys
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx

# Version Control System files
.git
.gitignore
.gitattributes
.github

# Dependencies & Package Lock local overrides
node_modules
**/node_modules
.npm

# Build & Output files
dist
**/dist
dist-ssr
build
**/build
coverage
**/coverage

# Logs & Runtime data
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Docker Configuration files (avoid recursive inclusion in build context)
docker-compose*.yml
docker-compose*.yaml
Dockerfile*
.dockerignore

# IDE & OS files
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Documentation & Assets not needed in container images
README.md
**/README.md
screenshots
docs
